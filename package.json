{
  "name": "porto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:content && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "check:release": "node --experimental-strip-types scripts/check-content.ts --release",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "build:pages": "node --experimental-strip-types scripts/build-pages.mjs",
    "build:release": "node --experimental-strip-types scripts/build-pages.mjs --release",
    "preview:pages": "node scripts/serve-out.mjs",
    "deploy:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloudflare.ps1",
    "verify:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-cloudflare.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
